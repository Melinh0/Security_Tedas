# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser commitado.

# Gere a DJANGO_SECRET_KEY com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Gere a ENCRYPTION_KEY com:
#   python manage.py generate_encryption_key
# GUARDE COMO SEGREDO: esta chave descriptografa todos os dados pessoais.
ENCRYPTION_KEY=

# Derivada automaticamente da ENCRYPTION_KEY se deixada vazia (opcional)
BLIND_INDEX_KEY=

DEBUG=True
LOG_LEVEL=INFO

# Producao: DEBUG=False e FORCE_HTTPS=True
FORCE_HTTPS=False

# localhost,127.0.0.1,seudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# https://seudominio.com
CSRF_TRUSTED_ORIGINS=

# https://app.seudominio.com,https://admin.seudominio.com
CORS_ALLOWED_ORIGINS=

# Producao: postgres://user:senha@db:5432/securityapi
# Local sem Docker: deixe vazio (usa SQLite para desenvolvimento)
DATABASE_URL=

# Redis para rate limiting distribuido (docker-compose define automaticamente)
REDIS_URL=

# Credenciais do docker-compose (obrigatorias para subir com Docker)
POSTGRES_USER=securityapi
POSTGRES_PASSWORD=
POSTGRES_DB=securityapi
REDIS_PASSWORD=

AUDIT_LOG_ENABLED=True
